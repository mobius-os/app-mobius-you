      { "id": "reflect", "label": "Reflect (DeepSeek V4.1 Flash)", "effort_levels": ["minimal", "low", "medium", "high", "max"], "context_window": 943718, "input_modalities": ["text", "image"], "auto_compact_token_limit": 420000 },
      { "id": "flow", "label": "Flow (GLM 5.3 Flash)", "effort_levels": ["minimal", "low", "medium", "high", "max"], "context_window": 943718, "input_modalities": ["text", "image"], "auto_compact_token_limit": 420000 },
      { "id": "prism", "label": "Prism (Gemini 3.8 Flash)", "effort_levels": ["minimal", "low", "medium", "high", "max"], "context_window": 943718, "input_modalities": ["text", "image"], "auto_compact_token_limit": 420000 }
